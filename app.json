{
  "expo": {
    "name": "Dish.",
    "slug": "dish",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-dish.png",
    "scheme": "dish",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.dish.mobile",
      "icon": "./assets/images/app-icon-dish.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dish. uses your location to show nearby dish versions."
      }
    },
    "android": {
      "package": "app.dish.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-dish.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon-dish.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDE9FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dish. uses your location to show nearby dish versions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
