# Expo (use your Railway public domain; use your Mac LAN IP for a physical-device local test)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Railway PostgreSQL injects DATABASE_URL automatically when the service is linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dish
PORT=3000
APP_ORIGIN=http://localhost:8081
SESSION_TTL_DAYS=30

# One-time bootstrap. The server creates this admin only when no admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-deploying
ADMIN_DISPLAY_NAME=Dish Admin

# Cloudflare R2. R2_PUBLIC_URL is the bucket custom domain in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dish-media
R2_PUBLIC_URL=https://media.example.com

# Optional: import the bundled demo dataset once on an empty database.
SEED_ON_START=false
# Upload the 20 bundled real-food photos to R2 under seed/food on that seed run.
SEED_UPLOAD_MEDIA=false
SEED_MEDIA_OBJECT_PREFIX=seed/food
